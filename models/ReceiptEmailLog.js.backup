
'use strict';

const mongoose = require('mongoose');

const { Schema } = mongoose;

const RECEIPT_EMAIL_STATUSES = Object.freeze([
  'pending',
  'sent',
  'failed'
]);

const receiptEmailLogSchema = new Schema(
  {
    order_id: {
      type: Schema.Types.ObjectId,
      ref: 'Order',
      required: true,
      index: true
    },

    customer_email: {
      type: String,
      required: true,
      trim: true,
      lowercase: true,
      maxlength: 254,
      validate: {
        validator(value) {
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
        },
        message: 'Please provide a valid customer email address.'
      }
    },

    status: {
      type: String,
      enum: RECEIPT_EMAIL_STATUSES,
      default: 'pending',
      required: true,
      lowercase: true,
      trim: true,
      index: true
    },

    brevo_message_id: {
      type: String,
      default: null,
      trim: true,
      maxlength: 255
    },

    error_message: {
      type: String,
      default: null,
      trim: true,
      maxlength: 5000
    },

    attempts: {
      type: Number,
      default: 0,
      min: 0,
      validate: {
        validator: Number.isInteger,
        message: 'Attempts must be a whole number.'
      }
    },

    sent_at: {
      type: Date,
      default: null
    }
  },
  {
    timestamps: {
      createdAt: 'created_at',
      updatedAt: 'updated_at'
    },

    collection: 'receipt_email_logs',
    versionKey: false,
    strict: true,
    minimize: false,

    toJSON: {
      virtuals: true
    },

    toObject: {
      virtuals: true
    }
  }
);

/*
|--------------------------------------------------------------------------
| Virtual Properties
|--------------------------------------------------------------------------
*/

receiptEmailLogSchema.virtual('is_sent').get(function () {
  return this.status === 'sent';
});

receiptEmailLogSchema.virtual('is_failed').get(function () {
  return this.status === 'failed';
});

/*
|--------------------------------------------------------------------------
| Validation Middleware
|--------------------------------------------------------------------------
*/

receiptEmailLogSchema.pre('validate', function () {
  if (this.status === 'sent') {
    this.sent_at = this.sent_at || new Date();
    this.error_message = null;
  } else {
    this.sent_at = null;
  }

  if (this.status !== 'failed') {
    this.error_message = null;
  }
});

/*
|--------------------------------------------------------------------------
| Instance Methods
|--------------------------------------------------------------------------
*/

receiptEmailLogSchema.methods.recordAttempt = function () {
  this.attempts += 1;
  this.status = 'pending';
  this.error_message = null;
  this.sent_at = null;

  return this.save();
};

receiptEmailLogSchema.methods.markAsSent = function (messageId = null) {
  this.status = 'sent';
  this.brevo_message_id = messageId;
  this.sent_at = new Date();
  this.error_message = null;

  return this.save();
};

receiptEmailLogSchema.methods.markAsFailed = function (error) {
  this.status = 'failed';
  this.error_message = error
    ? String(error.message || error).slice(0, 5000)
    : 'Receipt email delivery failed.';

  this.sent_at = null;

  return this.save();
};

/*
|--------------------------------------------------------------------------
| Static Methods
|--------------------------------------------------------------------------
*/

receiptEmailLogSchema.statics.findByOrder = function (orderId) {
  return this.find({ order_id: orderId })
    .sort({ created_at: -1 });
};

receiptEmailLogSchema.statics.findPending = function (limit = 100) {
  const safeLimit = Math.min(
    Math.max(Number(limit) || 100, 1),
    1000
  );

  return this.find({ status: 'pending' })
    .sort({ created_at: 1 })
    .limit(safeLimit);
};

receiptEmailLogSchema.statics.findByStatus = function (
  status,
  limit = 100
) {
  if (!RECEIPT_EMAIL_STATUSES.includes(status)) {
    throw new Error('Invalid receipt email status.');
  }

  const safeLimit = Math.min(
    Math.max(Number(limit) || 100, 1),
    1000
  );

  return this.find({ status })
    .sort({ created_at: -1 })
    .limit(safeLimit);
};

/*
|--------------------------------------------------------------------------
| Database Indexes
|--------------------------------------------------------------------------
*/

// Find receipt email records by order and status.
receiptEmailLogSchema.index(
  {
    order_id: 1,
    status: 1
  },
  {
    name: 'receipt_email_order_status'
  }
);

// Find customer receipt email history.
receiptEmailLogSchema.index(
  {
    customer_email: 1,
    created_at: -1
  },
  {
    name: 'receipt_email_customer_history'
  }
);

// Efficiently retrieve pending receipt emails.
receiptEmailLogSchema.index(
  {
    status: 1,
    created_at: 1
  },
  {
    name: 'receipt_email_pending_queue'
  }
);

/*
|--------------------------------------------------------------------------
| Model Registration
|--------------------------------------------------------------------------
*/

module.exports =
  mongoose.models.ReceiptEmailLog ||
  mongoose.model('ReceiptEmailLog', receiptEmailLogSchema);